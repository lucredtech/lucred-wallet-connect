# Copy to config.env on the host and fill UNDERWRITER_SECRET (only needed when enforcing).
# config.env is gitignored. Testnet only — mock tokens, no real value.
POOL_ID=CDW4G2YMN5RIXFTS6CW6XVNKPHJI4WZNAMUNHVKQZBD3G7QT45HELX63
RPC_URL=https://soroban-testnet.stellar.org
POLL_MS=30000
LOOKBACK_LEDGERS=6000

# SAFETY: DRY_RUN is the default (alert only). Set DRY_RUN=false to actually freeze flagged borrowers.
DRY_RUN=true
# Underwriter seed (S...) for GAYR73YO... — required only when DRY_RUN=false.
UNDERWRITER_SECRET=
# UNDERWRITER_SECRET_FILE=/run/secrets/underwriter

# Optional alerting (HMAC-signed with WEBHOOK_SECRET in x-lcrd-signature).
# WEBHOOK_URL=
# WEBHOOK_SECRET=

# Detection tuning (defaults match the contract floors a wash-cycler hugs).
# MIN_HOLD_DAYS=21
# UTIL_FLOOR_PCT=50
# WASH_CYCLES_TO_FLAG=2
# SYBIL_CLUSTER=4
# CONFIRM_OBSERVATIONS=2
